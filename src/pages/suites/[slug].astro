---
import Visor360Suites from '../../components/Visor360Suites.astro';
import FichaTecnica from '../../components/FichaTecnica.astro';
import Layout from '../../layouts/Layout.astro';
import { fichaTecnicaHabilitada, fichasUnidades } from '../../data/fichasUnidades';

export async function getStaticPaths() {
    return [
        { params: { slug: '606' } },
        { params: { slug: '607' } }
    ];
}

const { slug } = Astro.params; // Extraemos el slug de la URL
const ficha = fichasUnidades[`suite-${slug}`];
---
<Layout title=`Suite ${slug}`>
	<main>
		<Visor360Suites suite={slug} />
		{fichaTecnicaHabilitada && ficha && <FichaTecnica ficha={ficha} />}
		<!-- <Visor360AFrame /> -->
	</main>
</Layout>
