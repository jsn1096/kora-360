<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0f0e" />
    <title>Control · Kora 360</title>
  </head>
  <body>
    <main class="panel">
      <header class="encabezado">
        <div>
          <p class="eyebrow">KORA / 360</p>
          <h1>Control remoto</h1>
          <p class="subtitulo">Selecciona lo que quieres mostrar en el visor.</p>
        </div>
        <div id="estado-conexion" class="estado estado--conectando" aria-live="polite">
          <span class="estado-punto"></span>
          <span id="estado-texto">Conectando</span>
        </div>
      </header>

      <section class="escena-actual" aria-live="polite">
        <div class="actual-kicker">MOSTRANDO AHORA</div>
        <div class="actual-contenido">
          <span id="actual-icono" class="actual-icono">•</span>
          <div>
            <strong id="escena-actual">Esperando visor</strong>
            <span id="tipo-actual">Sala demo</span>
          </div>
        </div>
      </section>

      <label class="buscador">
        <span aria-hidden="true">⌕</span>
        <input id="buscar" type="search" placeholder="Buscar una escena" autocomplete="off" />
      </label>

      <div id="secciones" class="secciones">
        {secciones.map((sec, index) => (
          <details class="seccion" data-seccion={sec.id} open={index === 0}>
            <summary>
              <span class="seccion-icono">{sec.emoji}</span>
              <span class="seccion-titulos">
                <strong>{sec.label}</strong>
                <small>{sec.descripcion}</small>
              </span>
              <span class="seccion-cantidad">{sec.escenas.length}</span>
              <span class="seccion-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="escenas">
              {sec.escenas.map((escena) => (
                <button
                  type="button"
                  class:list={["btn-escena", escena.tipo === "video" && "btn-video"]}
                  data-escena={escena.id}
                  data-tipo={escena.tipo || "escena"}
                  data-seccion={sec.id}
                  data-label={escena.label}
                  data-detalle={escena.detalle}
                >
                  <span class="btn-icono">{escena.tipo === "video" ? "▶" : "→"}</span>
                  <span class="btn-textos">
                    <strong>{escena.label}</strong>
                    <small>{escena.detalle}</small>
                  </span>
                </button>
              ))}
            </div>
          </details>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #0b0f0e;
    color: #f2f4ef;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background:
      radial-gradient(circle at 90% -10%, rgba(112, 143, 93, 0.18), transparent 34rem),
      #0b0f0e;
  }

  button, input { font: inherit; }

  .panel {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: max(24px, env(safe-area-inset-top)) 18px calc(32px + env(safe-area-inset-bottom));
  }

  .encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 2px 24px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #a9bd91;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;
    font-size: clamp(27px, 8vw, 38px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .subtitulo {
    margin: 10px 0 0;
    color: #919b94;
    font-size: 13px;
  }

  .estado {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    padding: 8px 10px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    color: #aab2ac;
    font-size: 11px;
    white-space: nowrap;
  }

  .estado-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e0a55d;
  }

  .estado--conectado { color: #bcd9aa; border-color: rgba(137, 181, 112, 0.25); }
  .estado--conectado .estado-punto { background: #8fc277; box-shadow: 0 0 10px rgba(143, 194, 119, 0.8); }
  .estado--error { color: #e9a19b; border-color: rgba(214, 103, 93, 0.25); }
  .estado--error .estado-punto { background: #dc6e65; }

  .escena-actual {
    margin-bottom: 14px;
    padding: 17px 18px;
    border: 1px solid rgba(178, 203, 157, 0.22);
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(117, 151, 96, 0.2), rgba(255,255,255,0.035));
  }

  .actual-kicker {
    margin-bottom: 10px;
    color: #9eb98a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .actual-contenido { display: flex; align-items: center; gap: 12px; }
  .actual-icono {
    display: grid;
    width: 37px;
    height: 37px;
    place-items: center;
    border-radius: 12px;
    background: rgba(177, 207, 152, 0.16);
    color: #c2dda9;
    font-size: 22px;
  }
  #escena-actual { display: block; font-size: 17px; }
  #tipo-actual { display: block; margin-top: 3px; color: #9ba69d; font-size: 12px; }

  .buscador {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 14px;
    padding: 0 15px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 13px;
    background: rgba(255,255,255,0.045);
    color: #9ba69d;
  }
  .buscador span { font-size: 22px; line-height: 1; }
  .buscador input {
    width: 100%;
    padding: 13px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #f2f4ef;
    font-size: 14px;
  }
  .buscador input::placeholder { color: #778078; }

  .secciones { display: grid; gap: 10px; }
  .seccion {
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.085);
    border-radius: 17px;
    background: rgba(255,255,255,0.035);
  }
  .seccion[hidden] { display: none; }
  .seccion summary {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 68px;
    padding: 12px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .seccion summary::-webkit-details-marker { display: none; }
  .seccion-icono {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 11px;
    background: rgba(255,255,255,0.07);
    color: #bdd59f;
    font-size: 21px;
  }
  .seccion-titulos { display: grid; flex: 1; gap: 3px; }
  .seccion-titulos strong { font-size: 15px; }
  .seccion-titulos small { color: #818c84; font-size: 11px; }
  .seccion-cantidad {
    display: grid;
    min-width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 999px;
    background: rgba(255,255,255,0.07);
    color: #9fa9a0;
    font-size: 11px;
  }
  .seccion-chevron { color: #829087; font-size: 18px; transition: transform 0.2s; }
  .seccion[open] .seccion-chevron { transform: rotate(180deg); }

  .escenas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding: 0 10px 10px;
  }
  .btn-escena {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 62px;
    padding: 10px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 13px;
    background: rgba(255,255,255,0.045);
    color: #dce2db;
    text-align: left;
    cursor: pointer;
    touch-action: manipulation;
    transition: transform 0.15s, background 0.15s, border-color 0.15s;
  }
  .btn-escena:active { transform: scale(0.98); }
  .btn-escena:hover { border-color: rgba(183, 211, 157, 0.35); background: rgba(183, 211, 157, 0.1); }
  .btn-escena.activo { border-color: #9fca82; background: rgba(135, 178, 103, 0.2); }
  .btn-video { border-color: rgba(222, 172, 93, 0.24); }
  .btn-video:hover { border-color: rgba(222, 172, 93, 0.6); background: rgba(222, 172, 93, 0.12); }
  .btn-video.activo { border-color: #e0ae60; background: rgba(222, 172, 93, 0.2); }
  .btn-icono {
    display: grid;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 9px;
    background: rgba(255,255,255,0.07);
    color: #adc896;
    font-size: 16px;
  }
  .btn-video .btn-icono { color: #e0ae60; }
  .btn-textos { min-width: 0; margin-left: 8px; }
  .btn-textos strong { display: block; overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
  .btn-textos small { display: block; margin-top: 4px; overflow: hidden; color: #7e8980; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }

  @media (min-width: 600px) {
    .panel { padding: 42px 24px; }
    .encabezado { padding-bottom: 30px; }
    .escenas { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

<script>
  import PartySocket from "partysocket";

  const socket = new PartySocket({
    host: "tu-proyecto.jsn1096.partykit.dev",
    room: "sala-demo",
  });

  const estadoConexion = document.getElementById("estado-conexion");
  const estadoTexto = document.getElementById("estado-texto");
  const escenaActual = document.getElementById("escena-actual");
  const tipoActual = document.getElementById("tipo-actual");
  const actualIcono = document.getElementById("actual-icono");
  const botones = [...document.querySelectorAll(".btn-escena")];

  const cambiarEstado = (estado, texto) => {
    estadoConexion.className = `estado estado--${estado}`;
    estadoTexto.textContent = texto;
  };

  const mostrarEscena = (data) => {
    const boton = botones.find((item) =>
      item.dataset.escena === data.escena &&
      (!data.seccion || item.dataset.seccion === data.seccion),
    ) || botones.find((item) => item.dataset.escena === data.escena);
    if (!boton) return;

    botones.forEach((item) => item.classList.toggle("activo", item === boton));
    escenaActual.textContent = boton.dataset.label;
    tipoActual.textContent = data.type === "cambiar-video" ? "Video 360" : boton.dataset.detalle;
    actualIcono.textContent = data.type === "cambiar-video" ? "▶" : "→";
  };

  socket.addEventListener("open", () => cambiarEstado("conectado", "Conectado"));
  socket.addEventListener("close", () => cambiarEstado("error", "Sin conexión"));
  socket.addEventListener("error", () => cambiarEstado("error", "Error de conexión"));

  socket.addEventListener("message", (event) => {
    try {
      mostrarEscena(JSON.parse(event.data));
    } catch {
      cambiarEstado("error", "Mensaje inválido");
    }
  });

  botones.forEach((boton) => {
    boton.addEventListener("click", () => {
      if (socket.readyState !== 1) {
        cambiarEstado("error", "Sin conexión");
        return;
      }

      const tipo = boton.dataset.tipo === "video" ? "cambiar-video" : "cambiar-escena";
      const data = {
        type: tipo,
        escena: boton.dataset.escena,
        seccion: boton.dataset.seccion,
      };

      mostrarEscena(data);
      socket.send(JSON.stringify(data));
    });
  });

  document.getElementById("buscar").addEventListener("input", (event) => {
    const query = event.target.value.trim().toLocaleLowerCase();

    document.querySelectorAll(".seccion").forEach((seccion) => {
      const items = [...seccion.querySelectorAll(".btn-escena")];
      let visibles = 0;

      items.forEach((item) => {
        const coincide = !query || `${item.dataset.label} ${item.dataset.detalle}`.toLocaleLowerCase().includes(query);
        item.hidden = !coincide;
        if (coincide) visibles += 1;
      });

      seccion.hidden = visibles === 0;
      if (query && visibles > 0) seccion.open = true;
    });
  });
</script>
