---

<script src="https://aframe.io/releases/1.6.0/aframe.min.js"></script>

<div class="contenedor-vr">
  <a-scene
    embedded
    renderer="antialias: false; colorManagement: true; physicallyCorrectLights: false; precision: mediump;"
    vr-mode-ui="enabled: true"
  >
    <a-assets>
      <video id="video-360" loop crossorigin="anonymous" playsinline webkit-playsinline></video>
    </a-assets>
    <a-video
      id="sky-video"
      src="#video-360"
      width="16"
      height="9"
      position="0 1.6 -8"
      visible="false"
    ></a-video>
    <a-entity id="camera" position="0 1.6 0" camera="fov: 70" look-controls></a-entity>
  </a-scene>
</div>

<style>
  .contenedor-vr {
    width: 100%;
    height: 100vh;
    background: #000;
  }
</style>

<script define:vars={{ cubemaps, videos }} is:inline>
  let skyboxActual = null;
  let cargaActual = 0;
  let estadoPendiente = { type: 'cambiar-escena', escena: 'entrada1' };

  const detenerVideo = () => {
    const videoEl = document.getElementById('video-360');
    if (videoEl) {
      videoEl.pause();
      videoEl.removeAttribute('src');
      videoEl.load();
    }

    const skyVideo = document.getElementById('sky-video');
    if (skyVideo) skyVideo.setAttribute('visible', 'false');
  };

  const liberarSkybox = () => {
    if (skyboxActual) {
      skyboxActual.dispose();
      skyboxActual = null;
    }
  };

  const mostrarError = (nombreEscena, error) => {
    console.error(`No se pudo cargar la escena "${nombreEscena}"`, error);
  };

  window.cargarEscena = function (nombreEscena) {
    estadoPendiente = { type: 'cambiar-escena', escena: nombreEscena };
    const sceneEl = document.querySelector('a-scene');
    if (!sceneEl || !window.THREE) {
      return;
    }

    const data = cubemaps[nombreEscena];
    if (!data) {
      mostrarError(nombreEscena, 'Cubemap no encontrado');
      return;
    }

    const solicitud = ++cargaActual;
    detenerVideo();

    const renderer = sceneEl.renderer;
    const loader = new THREE.CubeTextureLoader();
    const texture = loader.load(
      [data.right, data.left, data.top, data.bottom, data.front, data.back],
      () => {
        if (solicitud !== cargaActual) {
          texture.dispose();
          return;
        }

        texture.colorSpace = THREE.SRGBColorSpace;
        if (renderer) {
          texture.anisotropy = Math.min(renderer.capabilities.getMaxAnisotropy(), 2);
        }

        const textureAnterior = skyboxActual;
        sceneEl.object3D.background = texture;
        skyboxActual = texture;
        if (textureAnterior && textureAnterior !== texture) textureAnterior.dispose();
      },
      undefined,
      (error) => {
        if (solicitud === cargaActual) mostrarError(nombreEscena, error);
        texture.dispose();
      },
    );

    texture.colorSpace = THREE.SRGBColorSpace;
  };

  window.cargarVideo = function (nombreVideo) {
    estadoPendiente = { type: 'cambiar-video', escena: nombreVideo };
    const sceneEl = document.querySelector('a-scene');
    const videoEl = document.getElementById('video-360');
    const skyVideo = document.getElementById('sky-video');
    if (!sceneEl || !videoEl || !skyVideo) return;

    const src = nombreVideo.startsWith('http') ? nombreVideo : videos[nombreVideo];
    if (!src) return;

    ++cargaActual;
    liberarSkybox();
    videoEl.src = src;
    videoEl.load();
    sceneEl.object3D.background = new THREE.Color(0x000000);
    skyVideo.setAttribute('visible', 'true');
    videoEl.play().catch(() => console.warn('El video requiere una interacción para iniciar'));
  };

  document.addEventListener('DOMContentLoaded', () => {
    const scene = document.querySelector('a-scene');
    if (!scene) return;

    const iniciar = () => {
      if (scene.renderer) {
        scene.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
      }
      if (estadoPendiente.type === 'cambiar-video') {
        window.cargarVideo(estadoPendiente.escena);
      } else {
        window.cargarEscena(estadoPendiente.escena);
      }
    };

    if (scene.hasLoaded) iniciar();
    else scene.addEventListener('loaded', iniciar, { once: true });
  });
</script>

<script>
  import PartySocket from "partysocket";

  const socket = new PartySocket({
    host: "tu-proyecto.jsn1096.partykit.dev",
    room: "sala-demo",
  });

  socket.addEventListener('message', (event) => {
    try {
      const data = JSON.parse(event.data);
      if (data.type === 'cambiar-escena') window.cargarEscena?.(data.escena);
      if (data.type === 'cambiar-video') window.cargarVideo?.(data.escena);
    } catch (error) {
      console.error('Mensaje de control inválido', error);
    }
  });
</script>
