---
const { dep, config } = Astro.props;
---

<div id="panorama-wrapper" style="width: 100%; height: 100vh; position: relative; background-color: #2c2c2c;">
  <div id="panorama" style="width: 100%; height: 100%;"></div>
</div>

<style is:global>
  .flecha-animada {
    width: 50px;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    border: 3px solid white;
    position: relative;
    cursor: pointer;
    pointer-events: auto;
  }
  .pnlm-load-box { display: none !important; }
  .flecha-animada::after {
    content: "∧";
    color: white;
    font-family: Arial, sans-serif;
    font-size: 32px;
    font-weight: bold;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
  }
  .flecha-animada::before {
    content: "";
    position: absolute;
    top: -12px; left: -12px; right: -12px; bottom: -12px;
    border: 3px solid white;
    border-radius: 50%;
    animation: latido 1.5s infinite ease-out;
  }
  @keyframes latido {
    0%   { transform: scale(0.8); opacity: 1; }
    100% { transform: scale(1.2); opacity: 0; }
  }
  .pnlm-tooltip { display: none !important; }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>

<script define:vars={{ config, dep }}>
  let visor = null;

  // Función para asignar ícono según el tipo/ID de escena
  const obtenerIcono = (sceneId) => {
    if (sceneId.includes('bano')) return '🚿';
    if (sceneId.includes('cuarto')) return '🛏️';
    return '🏠';
  };

  const crearMenu = () => {
    if (document.getElementById('menu-escenas')) return;

    const wrapper = document.getElementById('panorama-wrapper');
    const esMovil = window.innerWidth < 640;
    const menu = document.createElement('div');
    menu.id = 'menu-escenas';

    if (esMovil) {
      // Estilos Menú Desplegable (Móvil)
      Object.assign(menu.style, {
        position: 'absolute',
        top: '16px',
        left: '50%',
        transform: 'translateX(-50%)',
        zIndex: '9999',
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        background: 'rgba(0,0,0,0.75)',
        border: '1px solid rgba(255,255,255,0.25)',
        borderRadius: '20px',
        padding: '6px',
        width: 'max-content',
        backdropFilter: 'blur(8px)',
      });

      const firstSceneObj = config.scenes[config.firstScene];
      const btnTrigger = document.createElement('button');
      btnTrigger.id = 'btn-trigger-360';
      btnTrigger.innerHTML = `<span id="label-activo">${obtenerIcono(config.firstScene)} ${firstSceneObj?.title || config.firstScene}</span> <span style="font-size:10px; margin-left:6px;">▼</span>`;
      
      Object.assign(btnTrigger.style, {
        background: 'transparent',
        border: 'none',
        color: '#fff',
        fontSize: '13px',
        fontFamily: 'system-ui, sans-serif',
        padding: '6px 12px',
        cursor: 'pointer',
      });

      const listOpts = document.createElement('div');
      listOpts.id = 'lista-opciones-360';
      Object.assign(listOpts.style, {
        display: 'none',
        flexDirection: 'column',
        gap: '4px',
        width: '100%',
        marginTop: '6px',
        borderTop: '1px solid rgba(255,255,255,0.15)',
        paddingTop: '6px',
      });

      Object.keys(config.scenes).forEach((sceneId) => {
        const escena = config.scenes[sceneId];
        const btn = document.createElement('button');
        btn.dataset.escena = sceneId;
        btn.innerHTML = `<span style="font-size:14px">${obtenerIcono(sceneId)}</span> ${escena.title || sceneId}`;
        
        Object.assign(btn.style, {
          background: 'transparent',
          border: 'none',
          color: 'rgba(255,255,255,0.85)',
          borderRadius: '10px',
          padding: '8px 12px',
          fontSize: '13px',
          fontFamily: 'system-ui, sans-serif',
          cursor: 'pointer',
          textAlign: 'left',
          width: '100%',
        });

        btn.addEventListener('click', () => {
          if (visor) {
            visor.loadScene(sceneId);
            actualizarMenuActivo(sceneId);
          }
          listOpts.style.display = 'none';
        });

        listOpts.appendChild(btn);
      });

      btnTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const estaAbierto = listOpts.style.display === 'flex';
        listOpts.style.display = estaAbierto ? 'none' : 'flex';
      });

      document.addEventListener('click', () => {
        listOpts.style.display = 'none';
      });

      menu.appendChild(btnTrigger);
      menu.appendChild(listOpts);

    } else {
      // Estilos Horizontales (Escritorio)
      Object.assign(menu.style, {
        position: 'absolute',
        top: '20px',
        left: '50%',
        transform: 'translateX(-50%)',
        zIndex: '9999',
        display: 'flex',
        gap: '6px',
        background: 'rgba(0,0,0,0.55)',
        border: '1px solid rgba(255,255,255,0.2)',
        borderRadius: '40px',
        padding: '6px 10px',
      });

      Object.keys(config.scenes).forEach((sceneId) => {
        const escena = config.scenes[sceneId];
        const btn = document.createElement('button');
        btn.dataset.escena = sceneId;
        btn.innerHTML = `<span style="font-size:14px">${obtenerIcono(sceneId)}</span> ${escena.title || sceneId}`;

        Object.assign(btn.style, {
          background: 'transparent',
          border: '1px solid rgba(255,255,255,0.35)',
          color: 'rgba(255,255,255,0.85)',
          borderRadius: '30px',
          padding: '6px 16px',
          fontSize: '13px',
          fontFamily: 'system-ui, sans-serif',
          cursor: 'pointer',
          display: 'flex',
          alignItems: 'center',
          gap: '6px',
          whiteSpace: 'nowrap',
          transition: 'background 0.2s, color 0.2s',
        });

        btn.addEventListener('click', () => {
          if (visor) {
            visor.loadScene(sceneId);
            actualizarMenuActivo(sceneId);
          }
        });

        menu.appendChild(btn);
      });
    }

    wrapper.appendChild(menu);
    actualizarMenuActivo(config.firstScene);
  };

  const actualizarMenuActivo = (escenaId) => {
    const escenaObj = config.scenes[escenaId];
    const labelActivo = document.getElementById('label-activo');
    
    if (labelActivo && escenaObj) {
      labelActivo.innerHTML = `${obtenerIcono(escenaId)} ${escenaObj.title || escenaId}`;
    }

    document.querySelectorAll('#menu-escenas button[data-escena]').forEach(btn => {
      const esActivo = btn.dataset.escena === escenaId;
      btn.classList.toggle('activo', esActivo);

      if (window.innerWidth < 640) {
        btn.style.background = esActivo ? 'rgba(255,255,255,0.2)' : 'transparent';
        btn.style.color = esActivo ? '#fff' : 'rgba(255,255,255,0.85)';
        btn.style.fontWeight = esActivo ? '600' : '400';
      } else {
        Object.assign(btn.style, esActivo
          ? { background: 'rgba(255,255,255,0.92)', color: '#1a1a1a', border: '1px solid transparent', fontWeight: '600' }
          : { background: 'transparent', color: 'rgba(255,255,255,0.85)', border: '1px solid rgba(255,255,255,0.35)', fontWeight: '400' }
        );
      }
    });
  };

  const iniciarVisor = () => {
    if (document.getElementById('panorama') && typeof pannellum !== 'undefined') {
      crearMenu();

      if (visor) return;

      const pannellumScenes = {};
      Object.keys(config.scenes).forEach((sceneId) => {
        const item = config.scenes[sceneId];
        pannellumScenes[sceneId] = {
          type: "equirectangular",
          panorama: item.panorama,
          hotSpots: item.hotSpots || []
        };
      });

      visor = pannellum.viewer('panorama', {
        "default": {
          "firstScene": config.firstScene,
          "sceneFadeDuration": 1000,
          "autoLoad": true,
          "showControls": true,
          "autoRotate": 0
        },
        "scenes": pannellumScenes
      });

      visor.on('scenechange', (escenaId) => {
        actualizarMenuActivo(escenaId);
      });

    } else {
      setTimeout(iniciarVisor, 50);
    }
  };

  iniciarVisor();
</script>