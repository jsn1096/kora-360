---
const { dep, config } = Astro.props;
---

<div id="panorama-wrapper" style="width: 100%; height: 100vh; position: relative; background-color: #2c2c2c;">
  <div id="panorama" style="width: 100%; height: 100%;"></div>
</div>

<style is:global>
  .flecha-animada {
    width: 50px;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    border: 3px solid white;
    position: relative;
    cursor: pointer;
    pointer-events: auto;
  }
  .pnlm-load-box { display: none !important; }
  .flecha-animada::after {
    content: "∧";
    color: white;
    font-family: Arial, sans-serif;
    font-size: 32px;
    font-weight: bold;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
  }
  .flecha-animada::before {
    content: "";
    position: absolute;
    top: -12px; left: -12px; right: -12px; bottom: -12px;
    border: 3px solid white;
    border-radius: 50%;
    animation: latido 1.5s infinite ease-out;
  }
  @keyframes latido {
    0%   { transform: scale(0.8); opacity: 1; }
    100% { transform: scale(1.2); opacity: 0; }
  }
  .pnlm-tooltip { display: none !important; }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>

<script define:vars={{ config, dep }}>
  let visor = null;

  // Inyectar el menú dinámico para navegar entre las habitaciones del departamento actual
  const crearMenu = () => {
    if (document.getElementById('menu-escenas')) return;

    const wrapper = document.getElementById('panorama-wrapper');
    const menu = document.createElement('div');
    menu.id = 'menu-escenas';
    Object.assign(menu.style, {
      position: 'absolute',
      top: '20px',
      left: '50%',
      transform: 'translateX(-50%)',
      zIndex: '200',
      display: 'flex',
      gap: '6px',
      background: 'rgba(0,0,0,0.55)',
      border: '1px solid rgba(255,255,255,0.2)',
      borderRadius: '40px',
      padding: '6px 10px',
    });

    // Generar botones según las escenas del objeto config
    Object.keys(config.scenes).forEach((sceneId) => {
      const escena = config.scenes[sceneId];
      const btn = document.createElement('button');
      btn.dataset.escena = sceneId;
      btn.innerHTML = `<span style="font-size:14px">📍</span> ${escena.title || sceneId}`;

      const estilosBase = {
        background: 'transparent',
        border: '1px solid rgba(255,255,255,0.35)',
        color: 'rgba(255,255,255,0.85)',
        borderRadius: '30px',
        padding: '6px 16px',
        fontSize: '13px',
        fontFamily: 'system-ui, sans-serif',
        cursor: 'pointer',
        display: 'flex',
        alignItems: 'center',
        gap: '6px',
        whiteSpace: 'nowrap',
        transition: 'background 0.2s, color 0.2s',
      };

      Object.assign(btn.style, estilosBase);

      btn.addEventListener('mouseenter', () => {
        if (!btn.classList.contains('activo')) {
          btn.style.background = 'rgba(255,255,255,0.15)';
          btn.style.color = '#fff';
        }
      });
      btn.addEventListener('mouseleave', () => {
        if (!btn.classList.contains('activo')) {
          btn.style.background = 'transparent';
          btn.style.color = 'rgba(255,255,255,0.85)';
        }
      });

      btn.addEventListener('click', () => {
        if (visor) {
          visor.loadScene(sceneId);
          actualizarMenuActivo(sceneId);
        }
      });

      menu.appendChild(btn);
    });

    wrapper.appendChild(menu);
    actualizarMenuActivo(config.firstScene);
  };

  const actualizarMenuActivo = (escenaId) => {
    document.querySelectorAll('#menu-escenas button').forEach(btn => {
      const esActivo = btn.dataset.escena === escenaId;
      btn.classList.toggle('activo', esActivo);
      Object.assign(btn.style, esActivo
        ? { background: 'rgba(255,255,255,0.92)', color: '#1a1a1a', border: '1px solid transparent', fontWeight: '600' }
        : { background: 'transparent', color: 'rgba(255,255,255,0.85)', border: '1px solid rgba(255,255,255,0.35)', fontWeight: '400' }
      );
    });
  };

  const iniciarVisor = () => {
    if (document.getElementById('panorama') && typeof pannellum !== 'undefined') {
      crearMenu();

      if (visor) return;

      // Configuración de Pannellum usando el objeto config inyectado
      const pannellumScenes = {};
      Object.keys(config.scenes).forEach((sceneId) => {
        const item = config.scenes[sceneId];
        pannellumScenes[sceneId] = {
          type: "equirectangular",
          panorama: item.panorama,
          hotSpots: item.hotSpots || []
        };
      });

      visor = pannellum.viewer('panorama', {
        "default": {
          "firstScene": config.firstScene,
          "sceneFadeDuration": 1000,
          "autoLoad": true,
          "showControls": true,
          "autoRotate": 0
        },
        "scenes": pannellumScenes
      });

      visor.on('scenechange', (escenaId) => {
        actualizarMenuActivo(escenaId);
      });

    } else {
      setTimeout(iniciarVisor, 50);
    }
  };

  iniciarVisor();
</script>