---
interface Props {
  imagen: string;
}

const { imagen } = Astro.props;
---

<div id="panorama-wrapper" style="width: 100%; height: 100vh; position: relative; background-color: #2c2c2c;">
  <div id="panorama" data-panorama-src={imagen} style="width: 100%; height: 100%;"></div>
</div>

<style is:global>
  .pnlm-load-box { display: none !important; }
  .pnlm-tooltip { display: none !important; }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>

<script is:inline>
  const iniciarVisor = () => {
    const el = document.getElementById('panorama');
    if (el && typeof pannellum !== 'undefined') {
      const src = el.getAttribute('data-panorama-src');
      pannellum.viewer('panorama', {
        type: 'equirectangular',
        panorama: src,
        autoLoad: true,
        showControls: true,
        autoRotate: 0,
        hotSpots: []
      });
    } else {
      setTimeout(iniciarVisor, 50);
    }
  };

  iniciarVisor();
</script>