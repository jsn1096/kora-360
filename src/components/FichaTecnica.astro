---
import type { FichaUnidad } from '../data/fichasUnidades';

interface Props {
  ficha: FichaUnidad;
}

const { ficha } = Astro.props;

const tieneValor = (valor: unknown) =>
  valor !== undefined && valor !== null && valor !== '';

const formatoArea = new Intl.NumberFormat('es-EC', {
  maximumFractionDigits: 2,
});

const superficies = [
  { etiqueta: 'Área', valor: ficha.superficies.area, area: true },
  { etiqueta: 'Área balcón francés', valor: ficha.superficies.areaBalconFrances, area: true },
  { etiqueta: 'Área balcón', valor: ficha.superficies.areaBalcon, area: true },
  { etiqueta: 'Área total', valor: ficha.superficies.areaTotal, area: true },
  { etiqueta: 'Piso', valor: ficha.superficies.piso, area: false },
].filter((item) => tieneValor(item.valor));

const distribucion = [
  { etiqueta: 'Balcón', valor: ficha.distribucion.balcon, booleano: true },
  { etiqueta: 'Dormitorios', valor: ficha.distribucion.cuartos, booleano: false },
  { etiqueta: 'Baños', valor: ficha.distribucion.banos, booleano: false },
  { etiqueta: 'Cuarto de lavado', valor: ficha.distribucion.cuartoLavado, booleano: true },
].filter((item) => tieneValor(item.valor));

const mostrarValor = (valor: unknown, opciones: { area?: boolean; booleano?: boolean }) => {
  if (opciones.booleano) return valor ? 'Sí' : 'No';
  if (opciones.area && typeof valor === 'number') return `${formatoArea.format(valor)} m²`;
  return String(valor);
};
---

<div class="ficha-tecnica" data-ficha-root>
  <div class="ficha-toolbar" data-ficha-toolbar>
    <button
      class="ficha-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="ficha-panel"
      data-ficha-trigger
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M5 5h14M5 12h14M5 19h9" />
      </svg>
      <span>Ficha técnica</span>
    </button>
  </div>

  <div class="ficha-backdrop" data-ficha-backdrop hidden></div>

  <aside
    id="ficha-panel"
    class="ficha-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ficha-titulo"
    data-ficha-panel
    hidden
  >
    <header class="ficha-encabezado">
      <div class="ficha-marca">
        <img src="/renders/Kora Rojo@4x.png" alt="Kora Urban Soul" />
        <button class="ficha-cerrar" type="button" aria-label="Cerrar ficha técnica" data-ficha-close>
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </div>
      <div class="ficha-identidad">
        <span>{ficha.tipo}</span>
        <h2 id="ficha-titulo">{ficha.nombre}</h2>
      </div>
    </header>

    <div class="ficha-contenido">
      {ficha.ubicacionImagen && (
        <section class="ficha-ubicacion">
          <h3>Ubicación en piso</h3>
          <a
            class="ficha-ubicacion-imagen"
            href={ficha.ubicacionImagen}
            target="_blank"
            rel="noreferrer"
            aria-label={`Abrir ubicación en piso de ${ficha.nombre}`}
            data-ubicacion-enlace
          >
            <img
              src={ficha.ubicacionImagen}
              alt={`Ubicación en piso de ${ficha.nombre}`}
              loading="lazy"
              data-ubicacion-imagen
            />
          </a>
          <p class="ficha-ubicacion-vacia" data-ubicacion-vacia hidden>
            Imagen de ubicación pendiente
          </p>
        </section>
      )}

      {superficies.length > 0 && (
        <section>
          <h3>Superficies</h3>
          <dl>
            {superficies.map((item) => (
              <div class="ficha-fila">
                <dt>
                  <span class="ficha-icono" aria-hidden="true">◇</span>
                  {item.etiqueta}
                </dt>
                <dd>{mostrarValor(item.valor, { area: item.area })}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {distribucion.length > 0 && (
        <section>
          <h3>Distribución</h3>
          <dl>
            {distribucion.map((item) => (
              <div class="ficha-fila">
                <dt>
                  <span class="ficha-icono" aria-hidden="true">□</span>
                  {item.etiqueta}
                </dt>
                <dd>{mostrarValor(item.valor, { booleano: item.booleano })}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {superficies.length === 0 && distribucion.length === 0 && (
        <p class="ficha-vacia">La información técnica de esta unidad está por completar.</p>
      )}
    </div>
  </aside>
</div>

<style>
  .ficha-tecnica {
    position: relative;
    z-index: 10000;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .ficha-toolbar {
    position: fixed;
    top: 18px;
    left: 50%;
    z-index: 10002;
    display: flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    max-width: calc(100vw - 24px);
    transform: translateX(-50%);
  }

  .ficha-trigger {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
    height: 48px;
    min-height: 48px;
    box-sizing: border-box;
    padding: 0 16px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.86);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    white-space: nowrap;
  }

  .ficha-toolbar :global(#menu-escenas) {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    flex-shrink: 0;
    height: 48px !important;
    min-height: 48px !important;
    box-sizing: border-box !important;
    margin: 0 !important;
    border: 1px solid rgba(255, 255, 255, 0.45) !important;
    border-radius: 999px !important;
    background: rgba(10, 10, 10, 0.86) !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2) !important;
    backdrop-filter: blur(12px) !important;
    transform: none !important;
  }

  .ficha-toolbar :global(#lista-opciones-360) {
    position: absolute !important;
    top: calc(100% + 8px);
    left: 0;
    min-width: 100%;
    box-sizing: border-box;
    margin-top: 0 !important;
    padding: 8px !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 14px;
    background: rgba(10, 10, 10, 0.9);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(12px);
  }

  .ficha-tecnica.ficha-abierta .ficha-toolbar :global(#menu-escenas) {
    pointer-events: none;
  }

  .ficha-trigger svg,
  .ficha-cerrar svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .ficha-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(2px);
  }

  .ficha-panel {
    position: fixed;
    top: 72px;
    left: 18px;
    z-index: 10001;
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 36px));
    max-height: calc(100dvh - 90px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
    background: #fff;
    color: #202321;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
    animation: ficha-entrada 180ms ease-out;
  }

  .ficha-panel[hidden],
  .ficha-backdrop[hidden] {
    display: none;
  }

  .ficha-encabezado {
    flex-shrink: 0;
    padding: 22px 22px 18px;
    border-bottom: 1px solid #e8eae8;
  }

  .ficha-marca {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .ficha-marca img {
    display: block;
    width: min(205px, calc(100% - 56px));
    height: auto;
  }

  .ficha-identidad {
    margin-top: 22px;
  }

  .ficha-encabezado span {
    display: block;
    margin-bottom: 4px;
    color: #788078;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ficha-encabezado h2 {
    margin: 0;
    font-size: 25px;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .ficha-cerrar {
    display: grid;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid #d9ddda;
    border-radius: 50%;
    background: #f5f6f5;
    color: #222522;
    cursor: pointer;
  }

  .ficha-contenido {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 22px 24px;
    scrollbar-width: thin;
    scrollbar-color: #aeb3ae transparent;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
  }

  .ficha-contenido section {
    padding-top: 22px;
  }

  .ficha-ubicacion {
    padding-bottom: 4px;
  }

  .ficha-ubicacion-imagen {
    display: block;
    overflow: hidden;
    border: 1px solid #e1e4e1;
    border-radius: 12px;
    background: #f4f5f4;
  }

  .ficha-ubicacion-imagen img {
    display: block;
    width: 100%;
    height: auto;
    min-height: 112px;
    object-fit: contain;
  }

  .ficha-ubicacion-imagen[hidden] {
    display: none;
  }

  .ficha-ubicacion-vacia {
    display: grid;
    min-height: 112px;
    margin: 0;
    place-items: center;
    border: 1px dashed #cfd4cf;
    border-radius: 12px;
    background: #f4f5f4;
    color: #858c86;
    font-size: 12px;
    text-align: center;
  }

  .ficha-ubicacion-vacia[hidden] {
    display: none;
  }

  .ficha-contenido h3 {
    margin: 0 0 10px;
    color: #7a817b;
    font-size: 13px;
    font-weight: 600;
  }

  .ficha-contenido dl {
    margin: 0;
  }

  .ficha-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 50px;
    border-bottom: 1px solid #e5e7e5;
  }

  .ficha-fila dt {
    display: flex;
    align-items: center;
    min-width: 0;
    color: #4b514c;
    font-size: 14px;
  }

  .ficha-fila dd {
    flex-shrink: 0;
    margin: 0;
    color: #272b28;
    font-size: 14px;
    font-weight: 600;
    text-align: right;
  }

  .ficha-icono {
    display: grid;
    width: 25px;
    flex-shrink: 0;
    place-items: center;
    margin-right: 7px;
    color: #282d29;
    font-size: 20px;
  }

  .ficha-vacia {
    margin: 20px 0 0;
    padding: 18px;
    border-radius: 12px;
    background: #f3f5f3;
    color: #697069;
    font-size: 13px;
    line-height: 1.5;
  }

  @keyframes ficha-entrada {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 520px) {
    .ficha-toolbar {
      top: 12px;
      gap: 6px;
      max-width: calc(100vw - 16px);
    }

    .ficha-trigger {
      height: 48px;
      min-height: 48px;
      gap: 6px;
      padding: 0 12px;
      font-size: 12px;
    }

    .ficha-trigger svg {
      width: 18px;
      height: 18px;
    }

    .ficha-toolbar :global(#menu-escenas button) {
      padding-right: 10px !important;
      padding-left: 10px !important;
      font-size: 12px !important;
    }

    .ficha-panel {
      top: 64px;
      left: 12px;
      width: calc(100vw - 24px);
      max-height: calc(100dvh - 76px);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .ficha-panel { animation: none; }
  }
</style>

<script>
  const root = document.querySelector('[data-ficha-root]');

  if (root) {
    const toolbar = root.querySelector('[data-ficha-toolbar]');
    const trigger = root.querySelector('[data-ficha-trigger]');
    const panel = root.querySelector('[data-ficha-panel]');
    const backdrop = root.querySelector('[data-ficha-backdrop]');
    const close = root.querySelector('[data-ficha-close]');
    const ubicacionImagen = root.querySelector('[data-ubicacion-imagen]');
    const ubicacionEnlace = root.querySelector('[data-ubicacion-enlace]');
    const ubicacionVacia = root.querySelector('[data-ubicacion-vacia]');

    const mostrarUbicacionPendiente = () => {
      if (!ubicacionImagen || !ubicacionEnlace || !ubicacionVacia) return;
      ubicacionEnlace.hidden = true;
      ubicacionVacia.hidden = false;
    };

    if (ubicacionImagen) {
      ubicacionImagen.addEventListener('error', mostrarUbicacionPendiente);
      if (ubicacionImagen.complete && ubicacionImagen.naturalWidth === 0) {
        mostrarUbicacionPendiente();
      }
    }

    const cerrar = () => {
      panel.hidden = true;
      backdrop.hidden = true;
      root.classList.remove('ficha-abierta');
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    };

    const abrir = () => {
      panel.hidden = false;
      backdrop.hidden = false;
      root.classList.add('ficha-abierta');
      trigger.setAttribute('aria-expanded', 'true');
      close.focus();
    };

    const integrarSelectorEscenas = () => {
      const menuEscenas = document.getElementById('menu-escenas');
      if (!menuEscenas || toolbar.contains(menuEscenas)) return false;

      toolbar.appendChild(menuEscenas);
      return true;
    };

    if (!integrarSelectorEscenas()) {
      const observer = new MutationObserver(() => {
        if (integrarSelectorEscenas()) observer.disconnect();
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }

    trigger.addEventListener('click', () => {
      if (panel.hidden) abrir();
      else cerrar();
    });
    close.addEventListener('click', cerrar);
    backdrop.addEventListener('click', cerrar);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) cerrar();
    });
  }
</script>
