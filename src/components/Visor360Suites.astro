---
// Visor360.astro
const { suite } = Astro.props; // Espera "606" o "607"

// Armamos las rutas correspondientes de forma estricta según la suite activa
const imagenPrincipal = `/renders/${suite}-360.webp`;
const imagenCuarto = `/renders/cuarto-suite-${suite}.webp`;
const imagenBano = `/renders/baño6-ps.webp`;
---

<div id="panorama-wrapper" style="width: 100%; height: 100vh; position: relative; background-color: #2c2c2c;">
  <div id="panorama" style="width: 100%; height: 100%;"></div>
</div>

<style is:global>
  .flecha-animada {
    width: 50px;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    border: 3px solid white;
    position: relative;
    cursor: pointer;
    pointer-events: auto;
  }
  .pnlm-load-box { display: none !important; }
  .flecha-animada::after {
    content: "∧";
    color: white;
    font-family: Arial, sans-serif;
    font-size: 32px;
    font-weight: bold;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
  }
  .flecha-animada::before {
    content: "";
    position: absolute;
    top: -12px; left: -12px; right: -12px; bottom: -12px;
    border: 3px solid white;
    border-radius: 50%;
    animation: latido 1.5s infinite ease-out;
  }
  @keyframes latido {
    0%   { transform: scale(0.8); opacity: 1; }
    100% { transform: scale(1.2); opacity: 0; }
  }
  .pnlm-tooltip { display: none !important; }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>

<script define:vars={{ imagenPrincipal, imagenCuarto, imagenBano, suite }}>
  let visor = null;

  const ID_SUITE = `suite-${suite}`;
  const ID_CUARTO = `cuarto-${suite}`;
  const ID_BANO = `bano-${suite}`;

  const escenas = [
    { id: ID_SUITE, label: `Suite ${suite}`, icono: '🏠' },
    { id: ID_CUARTO, label: `Habitación`, icono: '🛏️' },
    { id: ID_BANO, label: `Baño`, icono: '🚿' }
  ];

  const crearMenu = () => {
    const wrapper = document.getElementById('panorama-wrapper');
    const esMovil = window.innerWidth < 640;

    const menu = document.createElement('div');
    menu.id = 'menu-escenas';

    if (esMovil) {
      // Estilos para Menú Desplegable Móvil
      Object.assign(menu.style, {
        position: 'absolute',
        top: '16px',
        left: '50%',
        transform: 'translateX(-50%)',
        zIndex: '9999',
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        background: 'rgba(0,0,0,0.75)',
        border: '1px solid rgba(255,255,255,0.25)',
        borderRadius: '20px',
        padding: '6px',
        width: 'max-content',
        backdropFilter: 'blur(8px)',
      });

      // Botón principal
      const btnTrigger = document.createElement('button');
      btnTrigger.id = 'btn-trigger-360';
      btnTrigger.innerHTML = `<span id="label-activo">🏠 Salón Suite ${suite}</span> <span style="font-size:10px; margin-left:6px;">▼</span>`;
      Object.assign(btnTrigger.style, {
        background: 'transparent',
        border: 'none',
        color: '#fff',
        fontSize: '13px',
        fontFamily: 'system-ui, sans-serif',
        padding: '6px 12px',
        cursor: 'pointer',
      });

      // Contenedor de opciones (oculto por defecto)
      const listOpts = document.createElement('div');
      listOpts.id = 'lista-opciones-360';
      Object.assign(listOpts.style, {
        display: 'none',
        flexDirection: 'column',
        gap: '4px',
        width: '100%',
        marginTop: '6px',
        borderTop: '1px solid rgba(255,255,255,0.15)',
        paddingTop: '6px',
      });

      escenas.forEach(({ id, label, icono }) => {
        const btn = document.createElement('button');
        btn.dataset.escena = id;
        btn.innerHTML = `<span style="font-size:14px">${icono}</span> ${label}`;
        Object.assign(btn.style, {
          background: 'transparent',
          border: 'none',
          color: 'rgba(255,255,255,0.85)',
          borderRadius: '10px',
          padding: '8px 12px',
          fontSize: '13px',
          fontFamily: 'system-ui, sans-serif',
          cursor: 'pointer',
          textAlign: 'left',
          width: '100%',
        });

        btn.addEventListener('click', () => {
          if (visor) {
            visor.loadScene(id);
            actualizarMenuActivo(id);
          }
          listOpts.style.display = 'none';
        });

        listOpts.appendChild(btn);
      });

      btnTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const estaAbierto = listOpts.style.display === 'flex';
        listOpts.style.display = estaAbierto ? 'none' : 'flex';
      });

      document.addEventListener('click', () => {
        listOpts.style.display = 'none';
      });

      menu.appendChild(btnTrigger);
      menu.appendChild(listOpts);

    } else {
      // Estilos Horizontales para Escritorio (Tu código original)
      Object.assign(menu.style, {
        position: 'absolute',
        top: '20px',
        left: '50%',
        transform: 'translateX(-50%)',
        zIndex: '9999',
        display: 'flex',
        gap: '6px',
        background: 'rgba(0,0,0,0.55)',
        border: '1px solid rgba(255,255,255,0.2)',
        borderRadius: '40px',
        padding: '6px 10px',
      });

      escenas.forEach(({ id, label, icono }) => {
        const btn = document.createElement('button');
        btn.dataset.escena = id;
        btn.innerHTML = `<span style="font-size:14px">${icono}</span> ${label}`;

        Object.assign(btn.style, {
          background: 'transparent',
          border: '1px solid rgba(255,255,255,0.35)',
          color: 'rgba(255,255,255,0.85)',
          borderRadius: '30px',
          padding: '6px 16px',
          fontSize: '13px',
          fontFamily: 'system-ui, sans-serif',
          cursor: 'pointer',
          display: 'flex',
          alignItems: 'center',
          gap: '6px',
          whiteSpace: 'nowrap',
          transition: 'background 0.2s, color 0.2s',
        });

        btn.addEventListener('click', () => {
          if (visor) {
            visor.loadScene(id);
            actualizarMenuActivo(id);
          }
        });

        menu.appendChild(btn);
      });
    }

    wrapper.appendChild(menu);
    actualizarMenuActivo(ID_SUITE);
  };

  const actualizarMenuActivo = (escenaId) => {
    const escenaObj = escenas.find(e => e.id === escenaId);
    const labelActivo = document.getElementById('label-activo');
    if (labelActivo && escenaObj) {
      labelActivo.innerHTML = `${escenaObj.icono} ${escenaObj.label}`;
    }

    document.querySelectorAll('#menu-escenas button[data-escena]').forEach(btn => {
      const esActivo = btn.dataset.escena === escenaId;
      btn.classList.toggle('activo', esActivo);

      if (window.innerWidth < 640) {
        btn.style.background = esActivo ? 'rgba(255,255,255,0.2)' : 'transparent';
        btn.style.color = esActivo ? '#fff' : 'rgba(255,255,255,0.85)';
        btn.style.fontWeight = esActivo ? '600' : '400';
      } else {
        Object.assign(btn.style, esActivo
          ? { background: 'rgba(255,255,255,0.92)', color: '#1a1a1a', border: '1px solid transparent', fontWeight: '600' }
          : { background: 'transparent', color: 'rgba(255,255,255,0.85)', border: '1px solid rgba(255,255,255,0.35)', fontWeight: '400' }
        );
      }
    });
  };

  const iniciarVisor = () => {
    if (document.getElementById('panorama') && typeof pannellum !== 'undefined') {

      crearMenu();

      const yawHaciaCuarto = suite === '606' ? 70 : 60;
      const yawHaciaSalon = suite === '606' ? 40 : 250;

      visor = pannellum.viewer('panorama', {
        "default": {
          "firstScene": ID_SUITE,
          "sceneFadeDuration": 1000,
          "autoLoad": true,
          "showControls": true,
          "autoRotate": 0
        },
        "scenes": {
          [ID_SUITE]: {
            "type": "equirectangular",
            "panorama": imagenPrincipal,
            "hotSpots": [
              { "pitch": 0, "yaw": yawHaciaCuarto, "type": "scene", "sceneId": ID_CUARTO, "cssClass": "flecha-animada" }
            ]
          },
          [ID_CUARTO]: {
            "type": "equirectangular",
            "panorama": imagenCuarto,
            "hotSpots": [
              { "pitch": 0, "yaw": yawHaciaSalon, "type": "scene", "sceneId": ID_SUITE, "cssClass": "flecha-animada" }
            ]
          },
          [ID_BANO]: {
            "type": "equirectangular",
            "panorama": imagenBano,
            "hotSpots": []
          }
        }
      });

      visor.on('scenechange', (escenaId) => {
        actualizarMenuActivo(escenaId);
      });

    } else {
      setTimeout(iniciarVisor, 50);
    }
  };

  iniciarVisor();
</script>