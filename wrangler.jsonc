{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kora-360-control",
  "main": "party/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "ControlRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ControlRoom"]
    }
  ]
}
